# Spotify (PUBLIC_ prefix = exposed to browser, no prefix = server-only)
PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Gemini (server-only, used for report card generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Apple Music (server-only, optional if not using Apple Music features)
APPLE_MUSIC_PRIVATE_KEY=your_base64_private_key
APPLE_MUSIC_TEAM_ID=your_apple_team_id
APPLE_MUSIC_KEY_ID=your_apple_key_id
