{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/exchange-spotify-code\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/generate-report\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/musickit-token\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/spotify-token\\/?$",
			"dest": "_render"
		}
	]
}