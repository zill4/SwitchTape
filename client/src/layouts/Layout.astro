---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Playlist Sync Pro" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script src="https://js-cdn.music.apple.com/musickit/v3/musickit.js"></script>
		<script src="https://kit.fontawesome.com/6de2ac1451.js" crossorigin="anonymous"></script>
		<!-- Security Headers -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; connect-src https: wss:;">
		<meta http-equiv="X-Content-Type-Options" content="nosniff">
		<meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
		<meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains">
		<!-- MusicKit JS needs origin sent on cross-origin requests to play.itunes.apple.com.
		     Browsers default to strict-origin-when-cross-origin which strips Referer enough
		     to break MusicKit auth (403 on webPlayerLogout). Explicitly set to "origin". -->
		<meta name="referrer" content="origin">
		<script is:inline>
			(function() {
				try {
					const stored = localStorage.getItem('theme');
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					const theme = stored || (prefersDark ? 'dark' : 'light');
					document.documentElement.setAttribute('data-theme', theme);
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<div class="app-wrapper">
			<Navigation />
			<main>
				<slot />
			</main>
		</div>
		<script is:inline>
			// Only redirect if not on localhost
			if (typeof window !== 'undefined' && 
				!window.location.hostname.includes('localhost') && 
				!window.location.hostname.includes('127.0.0.1') && 
				window.location.protocol === 'http:') {
				window.location.href = window.location.href.replace('http:', 'https:');
			}
		</script>
		<Footer />
	</body>
</html>
<style is:global>
	:root {
		--color-red: #ff0000;
		--color-black: #000000;
		--color-white: #ffffff;
		--nav-height: 64px;
		--font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;

		/* semantic theme tokens (light mode) */
		--bg: #ffffff;
		--surface: #ffffff;
		--surface-alt: #f5f5f5;
		--text: #000000;
		--text-muted: #666666;
		--text-soft: #333333;
		--border: #000000;
		--border-soft: #e5e5e5;
		--btn-secondary-hover: #f5f5f5;
		--btn-dark-hover: #333333;
	}

	[data-theme="dark"] {
		--bg: #0a0a0a;
		--surface: #141414;
		--surface-alt: #1f1f1f;
		--text: #f5f5f5;
		--text-muted: #999999;
		--text-soft: #cccccc;
		--border: #f5f5f5;
		--border-soft: #2a2a2a;
		--btn-secondary-hover: #1f1f1f;
		--btn-dark-hover: #2a2a2a;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html, body {
		height: 100%;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-family);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.app-wrapper {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		padding-top: var(--nav-height);
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem;
	}
</style>
