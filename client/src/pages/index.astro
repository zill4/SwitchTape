---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SwitchTape">
	<main>
		<section class="hero">
			<div class="logo-container">
				<img
					src="/images/switchtape-logo-black.png"
					alt="SwitchTape Logo"
					class="logo"
				/>
				<div class="established">EST. 2024</div>
			</div>

			<div class="cta-stack">
				<a href="/load-playlist" class="cta-card">
					<div class="cta-num">01</div>
					<div class="cta-body">
						<div class="cta-title">Transfer Your Playlist</div>
						<div class="cta-desc">Apple Music ↔ Spotify. Tracks, art, the whole tape.</div>
					</div>
					<div class="cta-arrow" aria-hidden="true">→</div>
				</a>

				<a href="/report-card" class="cta-card">
					<div class="cta-num">02</div>
					<div class="cta-body">
						<div class="cta-title">Music Taste Report</div>
						<div class="cta-desc">What does your library say about you? Find out.</div>
					</div>
					<div class="cta-arrow" aria-hidden="true">→</div>
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		padding: 2rem 0 4rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.logo-container {
		text-align: center;
		margin-bottom: 3rem;
	}

	.logo {
		max-width: 200px;
		height: auto;
		transition: filter 0.2s ease;
	}

	:global([data-theme="dark"]) .logo {
		filter: invert(1) hue-rotate(180deg);
	}

	.established {
		margin-top: 0.5rem;
		font-family: 'Courier New', Courier, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.25em;
		color: var(--text-muted);
		text-transform: uppercase;
	}

	.cta-stack {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.cta-card {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}

	.cta-card:hover {
		background: var(--color-red);
		color: var(--color-white);
		transform: translateX(2px);
	}

	.cta-card:hover .cta-num,
	.cta-card:hover .cta-desc,
	.cta-card:hover .cta-arrow {
		color: var(--color-white);
	}

	.cta-num {
		font-family: 'Courier New', Courier, monospace;
		font-size: 0.875rem;
		font-weight: bold;
		color: var(--color-red);
		letter-spacing: 0.05em;
		flex-shrink: 0;
		width: 2rem;
	}

	.cta-body {
		flex: 1;
		min-width: 0;
	}

	.cta-title {
		font-size: 1.125rem;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
		line-height: 1.2;
	}

	.cta-desc {
		font-size: 0.8125rem;
		color: var(--text-muted);
		line-height: 1.4;
		transition: color 0.15s ease;
	}

	.cta-arrow {
		font-size: 1.25rem;
		font-weight: bold;
		color: var(--text-muted);
		flex-shrink: 0;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.cta-card:hover .cta-arrow {
		transform: translateX(2px);
	}

	@media (max-width: 480px) {
		.cta-card {
			padding: 1rem 1.125rem;
			gap: 1rem;
		}

		.cta-title {
			font-size: 1rem;
		}

		.cta-desc {
			font-size: 0.75rem;
		}
	}
</style>
